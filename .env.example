# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Backend Configuration - Choose ONE of these options:

# Option 1: Railway Backend (if deployed there)
# NEXT_PUBLIC_API_URL=https://easybraillebackend-production.up.railway.app

# Option 2: Render Backend (recommended based on backend repo)
NEXT_PUBLIC_API_URL=https://easybraille-backend.onrender.com

# Fallback URLs
NEXT_PUBLIC_RAILWAY_BACKEND_URL=https://easybraillebackend-production.up.railway.app
NEXT_PUBLIC_RENDER_BACKEND_URL=https://easybraille-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://easybraille-backend.onrender.com

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# JWT Secret
JWT_SECRET=your-jwt-secret-key-here

# MongoDB Configuration (if using local database)
MONGODB_URI=mongodb://localhost:27017/easybraille_dev

# Production MongoDB (for production deployment)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/easybraille

# Additional Configuration
NODE_ENV=development